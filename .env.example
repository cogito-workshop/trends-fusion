# ============================================================================
# Trends Fusion - Environment Configuration Example
# Copy this file to .env and update the values
# ============================================================================

# ----------------------------------------------------------------------------
# Application Environment
# ----------------------------------------------------------------------------
NODE_ENV=development
VITE_APP_VERSION=1.0.0

# ----------------------------------------------------------------------------
# Development Server
# ----------------------------------------------------------------------------
VITE_DEV_SERVER_PORT=5173
VITE_DEV_SERVER_HOST=localhost

# ----------------------------------------------------------------------------
# Database Configuration
# ----------------------------------------------------------------------------
# Path to SQLite database file
DATABASE_PATH=./data/app.db

# Enable persistent cache
DATABASE_PERSISTENT_CACHE=true

# Database connection pool size
DATABASE_POOL_SIZE=10

# ----------------------------------------------------------------------------
# Cache Configuration
# ----------------------------------------------------------------------------

# Memory Cache Settings
CACHE_MEMORY_MAX_SIZE=1000
CACHE_MEMORY_DEFAULT_TTL=300000

# Persistent Cache Settings
CACHE_PERSISTENT_ENABLED=true
CACHE_PERSISTENT_MAX_ENTRIES=10000
CACHE_PERSISTENT_DEFAULT_TTL=3600000
CACHE_PERSISTENT_CACHE_DIR=./cache

# ----------------------------------------------------------------------------
# Sentry Error Monitoring
# Get your DSN from https://sentry.io
# ----------------------------------------------------------------------------
VITE_SENTRY_DSN=your_sentry_dsn_here

# Sample rate for performance tracing (0.0 - 1.0)
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Session replay sample rate (0.0 - 1.0)
VITE_SENTRY_REPLAY_SAMPLE_RATE=0.1

# Session replay session sample rate (0.0 - 1.0)
VITE_SENTRY_REPLAY_SESSION_SAMPLE_RATE=0.01

# ----------------------------------------------------------------------------
# Supabase Configuration (Optional)
# For cloud database sync
# ----------------------------------------------------------------------------
# VITE_SUPABASE_URL=your_supabase_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ----------------------------------------------------------------------------
# Firecrawl API (Optional)
# For web scraping functionality
# ----------------------------------------------------------------------------
# FIRECRAWL_API_KEY=your_firecrawl_api_key

# ----------------------------------------------------------------------------
# Redis Configuration (Optional)
# For distributed caching
# ----------------------------------------------------------------------------
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ----------------------------------------------------------------------------
# Logging Configuration
# ----------------------------------------------------------------------------
LOG_LEVEL=info
LOG_FILE=./logs/app.log
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# ----------------------------------------------------------------------------
# Performance Monitoring
# ----------------------------------------------------------------------------
# Enable performance metrics collection
VITE_PERFORMANCE_MONITORING=true

# Sample rate for performance metrics (0.0 - 1.0)
VITE_PERFORMANCE_SAMPLE_RATE=0.1

# Track slow renders (>16ms)
VITE_SLOW_RENDER_THRESHOLD=16

# ----------------------------------------------------------------------------
# Security Configuration
# ----------------------------------------------------------------------------
# Enable CSP (Content Security Policy)
ENABLE_CSP=true

# Trusted domains for API requests
TRUSTED_DOMAINS=localhost,127.0.0.1

# ----------------------------------------------------------------------------
# Feature Flags
# ----------------------------------------------------------------------------
# Enable/disable features
FEATURE_VIRTUAL_SCROLLING=true
FEATURE_PERFORMANCE_MONITOR=true
FEATURE_ERROR_BOUNDARIES=true
FEATURE_CACHE_STATS=true

# ----------------------------------------------------------------------------
# Build Configuration
# ----------------------------------------------------------------------------
# Build target
BUILD_TARGET=production

# Source map generation
GENERATE_SOURCEMAP=false

# Bundle analysis
BUNDLE_ANALYZER=false

# ----------------------------------------------------------------------------
# Testing Configuration
# ----------------------------------------------------------------------------
# Test environment
TEST_ENV=happy-dom

# Coverage thresholds
COVERAGE_STATEMENTS_THRESHOLD=80
COVERAGE_BRANCHES_THRESHOLD=70
COVERAGE_FUNCTIONS_THRESHOLD=80
COVERAGE_LINES_THRESHOLD=80

# ----------------------------------------------------------------------------
# CI/CD Configuration
# ----------------------------------------------------------------------------
# GitHub Actions
CI=true
GITHUB_ACTIONS=true

# Lighthouse CI
LHCI_GITHUB_APP_TOKEN=your_lighthouse_github_app_token

# Release configuration
AUTO_RELEASE=false
RELEASE_NOTES_TEMPLATE=./.github/release-template.md

# ----------------------------------------------------------------------------
# Development Tools
# ----------------------------------------------------------------------------
# Enable React DevTools
REACT_DEVTOOLS=true

# Enable Redux DevTools
REDUX_DEVTOOLS=true

# Hot Module Replacement
HMR=true

# Fast Refresh
FAST_REFRESH=true

# ----------------------------------------------------------------------------
# Production Optimizations
# ----------------------------------------------------------------------------
# Enable tree shaking
TREE_SHAKING=true

# Enable code splitting
CODE_SPLITTING=true

# Preload critical resources
PRELOAD_RESOURCES=true

# Compress assets
COMPRESS_ASSETS=true
