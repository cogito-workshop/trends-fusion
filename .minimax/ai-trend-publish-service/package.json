{
  "name": "ai-trend-publish-service",
  "version": "1.0.0",
  "description": "AI-powered content generation and publishing service (Node.js)",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/bootstrap.ts",
    "build": "tsc",
    "start": "node dist/bootstrap.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:init:sqlite": "tsx scripts/init-sqlite.ts",
    "db:init:supabase": "tsx scripts/init-supabase.ts",
    "db:migrate:mysql-to-sqlite": "tsx scripts/migrate-mysql-to-sqlite.ts",
    "db:migrate:mysql-to-supabase": "tsx scripts/migrate-mysql-to-supabase.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@prisma/client": "^5.20.0",
    "@supabase/supabase-js": "^2.46.1",
    "better-sqlite3": "^11.7.0",
    "bullmq": "^5.0.0",
    "dayjs": "^1.11.13",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "fastify-plugin": "^4.5.1",
    "handlebars": "^4.7.8",
    "ioredis": "^5.4.1",
    "mysql2": "^3.13.0",
    "node-cron": "^3.0.3",
    "pino": "^9.0.0",
    "pino-pretty": "^11.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.18.6",
    "@types/node-cron": "^3.0.11",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "prisma": "^5.20.0",
    "ts-jest": "^29.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2"
  }
}
