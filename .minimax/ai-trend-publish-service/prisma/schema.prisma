// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Config {
  id    Int    @id @default(autoincrement())
  key   String @map("key")
  value String @map("value")

  @@map("config")
}

model DataSource {
  id         Int    @id @default(autoincrement())
  platform   String @map("platform")
  identifier String @map("identifier")

  @@map("data_sources")
  @@unique([platform, identifier])
}

model Template {
  id           Int       @id @default(autoincrement())
  name         String    @map("name")
  description  String?   @map("description")
  platform     String    @map("platform")
  style        String    @map("style")
  content      String    @map("content")
  schema       Json?     @map("schema")
  exampleData  Json?     @map("example_data")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  createdBy    Int?      @map("created_by")

  versions     TemplateVersion[]
  categories   TemplateCategory[]

  @@map("templates")
}

model TemplateVersion {
  id         Int       @id @default(autoincrement())
  templateId Int       @map("template_id")
  version    String    @map("version")
  content    String    @map("content")
  schema     Json?     @map("schema")
  changes    String?   @map("changes")
  createdAt  DateTime  @default(now()) @map("created_at")
  createdBy  Int?      @map("created_by")

  template   Template  @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_versions")
  @@index([templateId])
}

model TemplateCategory {
  id         Int     @id @default(autoincrement())
  templateId Int     @map("template_id")
  category   String  @map("category")

  template   Template @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("template_categories")
  @@index([templateId])
}

model VectorItem {
  id          BigInt   @id @default(autoincrement())
  content     String?  @map("content")
  vector      Json?    @map("vector")
  vectorDim   Int?     @map("vector_dim")
  vectorType  String?  @map("vector_type")

  @@map("vector_items")
}
